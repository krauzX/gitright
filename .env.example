# GitRight Environment Configuration
# Copy this file to .env and fill in your values

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/gitright?sslmode=disable
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
SESSION_SECRET=replace_with_random_32_character_string
TOKEN_ENCRYPTION_KEY=replace_with_random_32_byte_string

# ─── Server ──────────────────────────────────────────────────────────────────
ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug
HTTP_TIMEOUT=5m

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
GITHUB_OAUTH_SCOPES=repo,user:email

# ─── Google AI (Optional - BYOK mode, users provide their own key) ──────────
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
GOOGLE_AI_USE_GROUNDING=false
GOOGLE_AI_TIMEOUT=60s
GOOGLE_AI_MAX_RETRIES=2

# ─── Database Pool ───────────────────────────────────────────────────────────
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# ─── Session ─────────────────────────────────────────────────────────────────
SESSION_MAX_AGE=86400

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ─── Security (Optional) ─────────────────────────────────────────────────────
ENABLE_HTTPS=false
CERT_FILE=
KEY_FILE=
